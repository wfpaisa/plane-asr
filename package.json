{
    "name": "plane-asr",
    "version": "1.0.3",
    "description": "Plane ASR — a local ASR GNOME Shell extension",
    "type": "module",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/wfpaisa/plane-asr.git"
    },
    "author": "Felipe Uribe",
    "license": "GPL-2.0-or-later",
    "bugs": {
        "url": "https://github.com/wfpaisa/plane-asr/issues"
    },
    "homepage": "https://github.com/wfpaisa/plane-asr#readme",
    "sideEffects": false,
    "scripts": {
        "build": "node scripts/gen-model-catalog.mjs && rm -rf dist && tsc",
        "pack": "make pack",
        "install": "make install",
        "setup": "make all && make pack && make install",
        "debug": "dbus-run-session gnome-shell --devkit --wayland",
        "lint": "eslint .",
        "test": "node scripts/gen-model-catalog.mjs && tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
        "format": "prettier --write .",
        "i18n": "make pot && make locale"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@girs/soup-3.0": "^4.1.0",
        "eslint": "^9.0.0",
        "globals": "^15.0.0",
        "prettier": "^3.9.5",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.0.0"
    },
    "dependencies": {
        "@girs/gjs": "^4.1.0",
        "@girs/gnome-shell": "^50.0.4"
    }
}

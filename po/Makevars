# Makevars — configuration for the gettext message catalog of plane-asr.
# See https://www.gnu.org/software/gettext/manual/html_node/po_2fMakevars.html

# The gettext domain. Must match metadata.json "gettext-domain" and the
# compiled .mo filename.
DOMAIN = planeasr

# Subdirectory of the top-level directory that holds .po files.
subdir = po

# Top-level source directory (relative to this po/ dir).
top_builddir = ..

# Files to scan for translatable strings (same list as POTFILES.in).
XGETTEXT_OPTIONS = \
  --keyword=_ \
  --keyword=N_ \
  --keyword=C_:1c,2 \
  --keyword=NC_:1c,2 \
  --keyword=g_dngettext:2,3 \
  --from-code=UTF-8 \
  --add-comments=TRANSLATORS: \
  --language=JavaScript

# Copyright holder and license for the .pot header.
copyright_holder = Felipe Uribe
PACKAGE_GNU = no

# Where to send bug reports for translations.
MSGID_BUGS_ADDRESS = https://github.com/wfpaisa/plane-asr/issues

# Files to ignore when scanning.
EXTRACT_TR = $(top_builddir)/po/POTFILES.in

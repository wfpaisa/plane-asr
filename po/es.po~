#: src/prefs/index.ts:652
msgid ""
    "When enabled, every transcription run is logged to the system journal "
    "(command line, exit status and the raw stdout/stderr of the ASR CLI). "
    "Inspect it with:\n"
    "journalctl --user -b /usr/bin/gnome-shell | grep planeasr"
msgstr "Cuando se activa, cada ejecución de transcripción se registra en el diario del sistema (línea de comandos, estado de salida y la salida stdout/stderr sin procesar del CLI ASR). Inspecciónelo con:\njournalctl --user -b /usr/bin/gnome-shell | grep planeasr"

#: src/prefs/index.ts:661
msgid "Debug logging"

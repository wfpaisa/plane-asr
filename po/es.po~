#: src/prefs/index.ts:601
msgid ""
    "Transcribe live in N-second chunks while you keep speaking, so the first "
    "words are pasted right away and backends with a per-call generation cap "
    "(e.g. Qwen3-ASR at 256 tokens) do not truncate the output."
msgstr "Transcribe en vivo en fragmentos de N segundos mientras sigue hablando, de modo que las primeras palabras se pegan de inmediato y los motores con un límite de generación por llamada (p. ej. Qwen3-ASR a 256 tokens) no truncan la salida."

#: src/prefs/index.ts:610
msgid "Live chunked transcription"
msgstr "Transcripción fragmentada en vivo"

#: src/prefs/index.ts:611
msgid "Process each N-second chunk as you speak"
msgstr "Procesar cada fragmento de N segundos mientras habla"

#: src/prefs/index.ts:616
msgid "Seconds per chunk"
msgstr "Segundos por fragmento"

#: src/prefs/index.ts:618
msgid "Lower values are safer for models that cap output tokens"
msgstr "Los valores bajos son más seguros para modelos que limitan los tokens de salida"

#: src/prefs/index.ts:632
msgid "Overlap seconds"
msgstr "Segundos de solapamiento"

#: src/prefs/index.ts:634
msgid ""
    "Re-transcribe this much at each chunk boundary so words split across the "
    "seam are not lost (0 = off)"
msgstr "Vuelve a transcribir esta cantidad en cada límite de fragmento para que no se pierdan las palabras divididas en la unión (0 = desactivado)"

#: src/prefs/index.ts:650
msgid "Debug"
